{% comment %}Shared styles and locally supplied Jost font assets.{% endcomment %}
{{ 'ss1-shared.css' | asset_url | stylesheet_tag }}
<style>
  @font-face {
    font-family: "SS1Jost";
    src: url("{{ 'ss1-jost-regular.ttf' | asset_url }}") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "SS1Jost";
    src: url("{{ 'ss1-jost-medium.ttf' | asset_url }}") format("truetype");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
</style>
